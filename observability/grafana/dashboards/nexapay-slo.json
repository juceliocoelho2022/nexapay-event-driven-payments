  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Portfolio/local target: >= 99% of Prometheus scrapes successful over the selected window.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 99}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "100 * avg(avg_over_time(up{job=\"nexapay-services\"}[$__range]))", "refId": "A"}],
      "title": "Availability",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Portfolio/local target: HTTP 5xx error ratio below 1% over 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"nexapay-services\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"nexapay-services\"}[5m])), 0.000001)", "refId": "A"}],
      "title": "HTTP 5xx Error Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Portfolio/local target: mean HTTP latency below 500 ms over 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 500}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "1000 * sum(rate(http_server_requests_seconds_sum{job=\"nexapay-services\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"nexapay-services\"}[5m])), 0.000001)", "refId": "A"}],
      "title": "Mean HTTP Latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Operational target: outbox publisher batch backlog should normally return to zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"expr": "sum(nexapay_outbox_batch_pending)", "refId": "A"}],
      "title": "Outbox Pending",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
