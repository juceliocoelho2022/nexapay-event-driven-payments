loki.source.file "nexapay_services" {
  targets = [
    { __path__ = "/var/log/nexapay/payment/nexapay-payment-service.log", service_name = "nexapay-payment-service" },
    { __path__ = "/var/log/nexapay/account/nexapay-account-service.log", service_name = "nexapay-account-service" },
    { __path__ = "/var/log/nexapay/ledger/nexapay-ledger-service.log", service_name = "nexapay-ledger-service" },
    { __path__ = "/var/log/nexapay/fraud/nexapay-fraud-service.log", service_name = "nexapay-fraud-service" },
    { __path__ = "/var/log/nexapay/auth/nexapay-auth-service.log", service_name = "nexapay-auth-service" },
  ]

  forward_to = [loki.process.nexapay_json.receiver]
  tail_from_end = false
}

loki.process "nexapay_json" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      level          = "level",
      service        = "service",
      correlation_id = "correlationId",
      logger_name    = "logger_name",
      thread_name    = "thread_name",
      message        = "message",
    }
  }

  // Low-cardinality field: safe to index as a Loki label.
  stage.labels {
    values = {
      level = "level",
    }
  }

  // High-cardinality/request-scoped fields stay searchable without creating
  // a new indexed stream for every request, logger or thread.
  stage.structured_metadata {
    values = {
      correlation_id = "correlation_id",
      logger_name     = "logger_name",
      thread_name     = "thread_name",
      service         = "service",
    }
  }
}

local.file_match "sprint7_validation" {
  path_targets = [
    {
      __path__ = "/var/log/nexapay/payment/sprint7-validation-*.log",
      service_name = "nexapay-sprint7-validation",
    },
  ]
  sync_period = "2s"
}

loki.source.file "sprint7_validation" {
  targets = local.file_match.sprint7_validation.targets
  forward_to = [loki.write.local.receiver]
  tail_from_end = false
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
